            'balance' => $running,
        ];

        return view('statements.supplier_statement', compact('supplier', 'display', 'totals', 'from', 'to'));
    }

    protected function buildCustomerTransactions(Customer $customer): array
    {
        $transactions = [];

        if ((float) $customer->opening_balance != 0) {
            $transactions[] = [
                'date' => $customer->created_at?->toDateString() ?? now()->toDateString(),
                'type' => 'opening',
                'label' => 'رصيد افتتاحي',
                'ref' => '-',
                'debit' => (float) $customer->opening_balance,
                'credit' => 0,
            ];
        }

        $invoices = Invoice::where('customer_id', $customer->id)
            ->whereIn('type', ['sale', 'sale_return'])
            ->orderBy('invoice_date')->orderBy('id')->get();

        foreach ($invoices as $inv) {
            $isSale = $inv->type === 'sale';
            $transactions[] = [
                'date' => $inv->invoice_date->toDateString(),
                'type' => $inv->type,
                'label' => $isSale ? 'فاتورة بيع' : 'مرتجع بيع',
                'ref' => $inv->invoice_no,
                'debit' => $isSale ? (float) $inv->total : 0,
                'credit' => $isSale ? 0 : (float) $inv->total,
            ];
        }

        $payments = Payment::where('customer_id', $customer->id)
            ->where('type', 'receipt')
            ->orderBy('payment_date')->orderBy('id')->get();

        foreach ($payments as $pay) {
            $transactions[] = [
                'date' => $pay->payment_date->toDateString(),
                'type' => 'receipt',
                'label' => 'سند قبض (' . $this->paymentMethodLabel($pay->payment_method) . ')',
                'ref' => $pay->payment_no,
                'debit' => 0,
                'credit' => (float) $pay->amount,
            ];
        }

        usort($transactions, fn($a, $b) => strcmp($a['date'], $b['date']));

        return $transactions;
    }

    protected function buildSupplierTransactions(Supplier $supplier): array
    {
        $transactions = [];

        if ((float) $supplier->opening_balance != 0) {
            $transactions[] = [
                'date' => $supplier->created_at?->toDateString() ?? now()->toDateString(),
                'type' => 'opening',
                'label' => 'رصيد افتتاحي',
                'ref' => '-',
                'debit' => 0,
                'credit' => (float) $supplier->opening_balance,
            ];
        }

        $invoices = Invoice::where('supplier_id', $supplier->id)
            ->whereIn('type', ['purchase', 'purchase_return'])
            ->orderBy('invoice_date')->orderBy('id')->get();

        foreach ($invoices as $inv) {
            $isPurchase = $inv->type === 'purchase';
            $transactions[] = [
                'date' => $inv->invoice_date->toDateString(),
                'type' => $inv->type,
                'label' => $isPurchase ? 'فاتورة شراء' : 'مرتجع شراء',
                'ref' => $inv->invoice_no,
                'debit' => $isPurchase ? 0 : (float) $inv->total,
                'credit' => $isPurchase ? (float) $inv->total : 0,
            ];
        }

        $payments = Payment::where('supplier_id', $supplier->id)
            ->where('type', 'payment')
            ->orderBy('payment_date')->orderBy('id')->get();

        foreach ($payments as $pay) {
            $transactions[] = [
                'date' => $pay->payment_date->toDateString(),
                'type' => 'payment',
                'label' => 'سند صرف (' . $this->paymentMethodLabel($pay->payment_method) . ')',
                'ref' => $pay->payment_no,
                'debit' => (float) $pay->amount,
                'credit' => 0,
            ];
        }

        usort($transactions, fn($a, $b) => strcmp($a['date'], $b['date']));

        return $transactions;
    }

    protected function paymentMethodLabel(string $method): string
    {
        return match ($method) {
            'cash' => 'نقدي',
            'card' => 'بطاقة',
            'bank_transfer' => 'تحويل بنكي',
            'cheque' => 'شيك',
            'credit' => 'آجل',
            default => $method,
        };
    }
