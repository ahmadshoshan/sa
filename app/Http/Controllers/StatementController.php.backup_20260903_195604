<?php

namespace App\Http\Controllers;

use App\Models\Customer;
use App\Models\Supplier;
use App\Models\Invoice;
use App\Models\Payment;
use Illuminate\Http\Request;

class StatementController extends Controller
{
    public function index(Request $request)
    {
        $tab = $request->input('tab', 'customers');

        $customers = Customer::orderBy('name')->get()
            ->map(function ($c) {
                $c->sales_total = (float) Invoice::where('customer_id', $c->id)->where('type', 'sale')->sum('total');
                $c->returns_total = (float) Invoice::where('customer_id', $c->id)->where('type', 'sale_return')->sum('total');
                $c->payments_total = (float) Payment::where('customer_id', $c->id)->where('type', 'receipt')->sum('amount');
                return $c;
            });

        $suppliers = Supplier::orderBy('name')->get()
            ->map(function ($s) {
                $s->purchases_total = (float) Invoice::where('supplier_id', $s->id)->where('type', 'purchase')->sum('total');
                $s->returns_total = (float) Invoice::where('supplier_id', $s->id)->where('type', 'purchase_return')->sum('total');
                $s->payments_total = (float) Payment::where('supplier_id', $s->id)->where('type', 'payment')->sum('amount');
                return $s;
            });

        return view('statements.index', compact('customers', 'suppliers', 'tab'));
    }

        public function customerStatement(Customer $customer, Request $request)
    {
        $from = $request->input('from');
        $to = $request->input('to');
        
        // جلب الفواتير (بيع + مرتجعات بيع)
        $invoicesQuery = Invoice::where('customer_id', $customer->id)
            ->whereIn('type', ['sale', 'sale_return']);
        
        // جلب السندات (قبض من العميل + دفع للعميل = كل السندات الخاصة بالعميل)
        $paymentsQuery = Payment::where('customer_id', $customer->id)
            ->whereIn('type', ['receipt', 'payment']);
        
        if ($from) {
            $invoicesQuery->whereDate('invoice_date', '>=', $from);
            $paymentsQuery->whereDate('payment_date', '>=', $from);
        }
        if ($to) {
            $invoicesQuery->whereDate('invoice_date', '<=', $to);
            $paymentsQuery->whereDate('payment_date', '<=', $to);
        }
        
        $invoices = $invoicesQuery->orderBy('invoice_date', 'asc')->orderBy('id', 'asc')->get();
        $payments = $paymentsQuery->orderBy('payment_date', 'asc')->orderBy('id', 'asc')->get();
        
        // حساب الرصيد التشغيلي
        $runningBalance = (float) ($customer->opening_balance ?? 0);
        
        $transactions = collect();
        
        // إضافة الفواتير
        foreach ($invoices as $inv) {
            $amount = (float) $inv->total;
            $isReturn = $inv->type === 'sale_return';
            
            if ($isReturn) {
                // المرتجع: العميل يصبح دائن لنا (الرصيد ينقص)
                $runningBalance -= $amount;
            } else {
                // الفاتورة: العميل مدين لنا (الرصيد يزيد)
                $runningBalance += $amount;
            }
            
            $transactions->push([
                'date' => $inv->invoice_date . ' 00:00',
                'sort_key' => $inv->invoice_date . '_0_' . $inv->id,
                'type' => $isReturn ? 'مرتجع بيع' : 'فاتورة بيع',
                'reference' => $inv->invoice_no,
                'debit' => $isReturn ? 0 : $amount,
                'credit' => $isReturn ? $amount : 0,
                'balance' => $runningBalance,
                'icon' => $isReturn ? '↩️' : '🧾',
                'class' => $isReturn ? 'text-warning' : 'text-primary',
            ]);
        }
        
        // إضافة السندات
        foreach ($payments as $pay) {
            $amount = (float) $pay->amount;
            $isReceipt = $pay->type === 'receipt';
            
            if ($isReceipt) {
                // سند قبض من العميل: دفع لنا (الرصيد ينقص)
                $runningBalance -= $amount;
            } else {
                // سند صرف للعميل: نحن دفعنا له (الرصيد يزيد - لأنه كان سالب)
                $runningBalance += $amount;
            }
            
            $transactions->push([
                'date' => $pay->payment_date . ' 00:00',
                'sort_key' => $pay->payment_date . '_1_' . $pay->id,
                'type' => $isReceipt ? 'سند قبض من العميل' : 'سند صرف للعميل (رد مستحقات)',
                'reference' => $pay->payment_no,
                'debit' => $isReceipt ? 0 : $amount,
                'credit' => $isReceipt ? $amount : 0,
                'balance' => $runningBalance,
                'icon' => $isReceipt ? '💵' : '💳',
                'class' => $isReceipt ? 'text-success' : 'text-danger',
                'method' => $pay->payment_method,
                'notes' => $pay->notes,
            ]);
        }
        
        // ترتيب حسب التاريخ
        $transactions = $transactions->sortBy('sort_key')->values();
        
        // الإحصائيات
        $totalDebit = $transactions->sum('debit');
        $totalCredit = $transactions->sum('credit');
        
        return view('statements.customer', compact(
            'customer', 'transactions', 'from', 'to', 'totalDebit', 'totalCredit'
        ));
    }));

        $totals = [
            'debit' => array_sum(array_column($display, 'debit')),
            'credit' => array_sum(array_column($display, 'credit')),
            'balance' => $running,
        ];

        return view('statements.customer_statement', compact('customer', 'display', 'totals', 'from', 'to'));
    }

