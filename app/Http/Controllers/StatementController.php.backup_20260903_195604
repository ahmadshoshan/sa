                'debit' => $isPayment ? $amount : 0,
                'credit' => $isPayment ? 0 : $amount,
                'balance' => $runningBalance,
                'icon' => $isPayment ? '💸' : '💰',
                'class' => $isPayment ? 'text-success' : 'text-danger',
                'method' => $pay->payment_method,
                'notes' => $pay->notes,
            ]);
        }
        
        $transactions = $transactions->sortBy('sort_key')->values();
        $totalDebit = $transactions->sum('debit');
        $totalCredit = $transactions->sum('credit');
        
        return view('statements.supplier', compact(
            'supplier', 'transactions', 'from', 'to', 'totalDebit', 'totalCredit'
        ));
    }));

        $totals = [
            'debit' => array_sum(array_column($display, 'debit')),
